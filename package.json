{
  "name": "flarelette-demo",
  "version": "1.0.0",
  "description": "Production-ready Cloudflare Workers microservices template built with Flarelette",
  "private": true,
  "type": "module",
  "scripts": {
    "archlette": "npx archlette all -f docs/archlette.config.yaml",
    "dev": "node scripts/start-dev.js",
    "dev:workers": "tsx scripts/miniflare.ts",
    "dev:ui": "cd ui && pnpm dev",
    "kill-ports": "node scripts/kill-dev-ports.js",
    "build": "pnpm -r build",
    "deploy": "pnpm -r deploy",
    "setup:local": "node scripts/setup.js --env local --clean",
    "setup:preview": "node scripts/setup.js --env preview --clean",
    "seed:preview": "node scripts/setup.js --env preview",
    "seed:prod": "node scripts/setup.js --env production",
    "generate:keys": "node scripts/generate-keys.js",
    "mint-token": "node scripts/mint-token.js",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "api-security": "spectral lint workers/gateway/openapi.yaml --ruleset .spectral.yaml",
    "check": "pnpm test && pnpm lint && pnpm api-security && pnpm archlette && pnpm format && pnpm type-check"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "microservices",
    "jwt",
    "auth",
    "template",
    "flarelette",
    "hono"
  ],
  "author": "Chris Lyons",
  "license": "MIT",
  "devDependencies": {
    "@chrislyons-dev/archlette": "^1.2.0",
    "@stoplight/spectral-cli": "^6.15.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "miniflare": "^3.20231030.4",
    "prettier": "^3.1.0",
    "tsx": "^4.7.0",
    "wrangler": "^4.45.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
