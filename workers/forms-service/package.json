{
  "name": "forms-service",
  "version": "1.0.0",
  "description": "Form submission service (contact, tryouts, etc.)",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
