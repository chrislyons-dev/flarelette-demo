  "deployments": [
    {
      "name": "production",
      "environment": "production",
      "platform": "Cloudflare Workers",
      "instances": [
        {
          "id": "production__flarelette_demo_ui",
          "containerRef": "flarelette_demo_ui",
          "name": "flarelette-demo-ui",
          "type": "Cloudflare Worker",
          "vars": {
            "PUBLIC_API_BASE_URL": "https://flarelette.chrislyons.dev",
            "PUBLIC_SITE_URL": "https://flarelette.chrislyons.dev"
          }
        },
        {
          "id": "production__content_service",
          "containerRef": "content_service",
          "name": "content-service",
          "type": "Cloudflare Worker",
          "bindings": [
            {
              "type": "d1",
              "binding": "DB",
              "database": "content-db"
            }
          ],
          "vars": {
            "JWT_ISS": "https://gateway.internal",
            "JWT_AUD": "flarelette.mesh"
          }
        },
        {
          "id": "production__forms_service",
          "containerRef": "forms_service",
          "name": "forms-service",
          "type": "Cloudflare Worker",
          "bindings": [
            {
              "type": "d1",
              "binding": "DB",
              "database": "forms-db"
            }
          ],
          "vars": {
            "JWT_ISS": "https://gateway.internal",
            "JWT_AUD": "flarelette.mesh"
          }
        },
        {
          "id": "production__gateway",
          "containerRef": "gateway",
          "name": "gateway",
          "type": "Cloudflare Worker",
          "bindings": [
            {
              "type": "service",
              "binding": "CONTENT_SERVICE",
              "service": "content-service"
            },
            {
              "type": "service",
              "binding": "IMAGE_SERVICE",
              "service": "image-service"
            },
            {
              "type": "service",
              "binding": "FORMS_SERVICE",
              "service": "forms-service"
            }
          ],
          "vars": {
            "JWT_ISS": "https://gateway.internal",
            "JWT_AUD": "flarelette.mesh",
            "JWT_TTL_SECONDS": "900",
            "AUTH0_DOMAIN": "your-tenant.auth0.com",
            "AUTH0_AUDIENCE": "https://your-api.example.com"
          }
        },
        {
          "id": "production__image_service",
          "containerRef": "image_service",
          "name": "image-service",
          "type": "Cloudflare Worker",
          "bindings": [
            {
              "type": "r2",
              "binding": "IMAGES",
              "bucket": "images"
            }
          ],
          "vars": {
            "JWT_ISS": "https://gateway.internal",
            "JWT_AUD": "flarelette.mesh"
          }
        }
      ]
    },
