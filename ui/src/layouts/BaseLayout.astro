---
interface Props {
  title: string
  description?: string
}

const { title, description = 'Flarelette microservices demo' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <!-- Flarelette Favicon -->
    <link rel="icon" type="image/png" sizes="128x128" href="/flarelette-light-mode-128.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="128x128" href="/flarelette-dark-mode-128.png" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="256x256" href="/flarelette-light-mode-256.png" />
    <link rel="apple-touch-icon" sizes="256x256" href="/flarelette-light-mode-256.png" />
    <!-- Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-neutral-light font-sans">
    <nav class="bg-navy border-b border-navy-light">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex">
            <a href="/" class="flex items-center space-x-3">
              <img src="/flarelette-dark-mode-128.png" alt="Flarelette" class="h-8 w-8" />
              <span class="text-xl font-semibold text-white">Flarelette Demo</span>
            </a>
            <div class="ml-10 flex items-center space-x-1">
              <a href="/" class="text-neutral-light hover:text-white px-3 py-2 rounded-md text-sm font-semibold transition-colors">
                Home
              </a>
              <a href="/events" class="text-neutral-light hover:text-white px-3 py-2 rounded-md text-sm font-semibold transition-colors">
                Events
              </a>
              <a href="/news" class="text-neutral-light hover:text-white px-3 py-2 rounded-md text-sm font-semibold transition-colors">
                News
              </a>
              <a href="/roster" class="text-neutral-light hover:text-white px-3 py-2 rounded-md text-sm font-semibold transition-colors">
                Roster
              </a>
              <a href="/contact" class="text-neutral-light hover:text-white px-3 py-2 rounded-md text-sm font-semibold transition-colors">
                Contact
              </a>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="bg-navy mt-16 border-t border-navy-light">
      <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-center space-x-3">
          <img src="/flarelette-dark-mode-128.png" alt="Flarelette" class="h-6 w-6 opacity-75" />
          <p class="text-center text-neutral-light text-sm">
            Built with <a href="https://github.com/chrislyons-dev/flarelette-hono" class="text-teal hover:text-teal-light font-semibold transition-colors">flarelette-hono</a> &middot;
            Secure JWTs at the edge
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
