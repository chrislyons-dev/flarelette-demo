---
/**
 * Home Page - Landing page for Flarelette Demo application
 *
 * @actor User {Person} {in} End user who interacts with the Flarelette Demo UI
 * @uses gateway Communicates with Gateway API for content, form, & image services
 */

import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Welcome to Flarelette Demo">
  <div class="bg-gradient-to-br from-navy to-navy-light relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-flame-red via-flame-orange to-flame-yellow opacity-5"></div>
    <div class="max-w-7xl mx-auto py-20 px-4 sm:px-6 lg:px-8 relative">
      <div class="flex items-center space-x-4 mb-6">
        <img src="/flarelette-dark-mode-256.png" alt="Flarelette" class="h-16 w-16" />
        <h1 class="text-5xl font-bold text-white">
          Flarelette
        </h1>
      </div>
      <p class="text-2xl text-white max-w-3xl mb-4 font-semibold">
        Secure JWTs at the edge
      </p>
      <p class="text-lg text-gray-200 max-w-3xl">
        Production-ready template for building Cloudflare Workers applications with JWT authentication,
        D1 databases, R2 storage, and Astro frontend — all on the free tier.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      <div class="bg-white p-6 rounded-lg shadow-sm border-t-4 border-orange">
        <h2 class="text-2xl font-bold mb-3 text-navy">Zero Trust Security</h2>
        <p class="text-gray-700 leading-relaxed">
          All API requests authenticated with HS512-signed internal JWTs. Gateway mints short-lived tokens
          for every request, verified by each microservice.
        </p>
      </div>

      <div class="bg-white p-6 rounded-lg shadow-sm border-t-4 border-teal">
        <h2 class="text-2xl font-bold mb-3 text-navy">Free Tier Friendly</h2>
        <p class="text-gray-700 leading-relaxed">
          Built to run entirely on Cloudflare's generous free tier: Workers, Pages, D1, and R2.
          Perfect for school sites, small businesses, and side projects.
        </p>
      </div>

      <div class="bg-white p-6 rounded-lg shadow-sm border-t-4 border-navy">
        <h2 class="text-2xl font-bold mb-3 text-navy">Production Ready</h2>
        <p class="text-gray-700 leading-relaxed">
          Input validation with Zod, OpenAPI specs, structured logging, and GitHub Actions deployment.
          Clone and customize for your next project.
        </p>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm p-8 border border-gray-200">
      <h2 class="text-3xl font-bold mb-6 text-navy">Features</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h3 class="text-lg font-semibold mb-2 text-teal">Gateway</h3>
          <ul class="list-disc list-inside text-gray-700 space-y-1 leading-relaxed">
            <li>HS512 JWT signing with shared secrets</li>
            <li>Input validation with Zod</li>
            <li>OpenAPI 3.1 specification</li>
            <li>Service bindings to microservices</li>
          </ul>
        </div>

        <div>
          <h3 class="text-lg font-semibold mb-2 text-teal">Content Service</h3>
          <ul class="list-disc list-inside text-gray-700 space-y-1 leading-relaxed">
            <li>D1-backed CMS (SQLite)</li>
            <li>News, events, roster, pages</li>
            <li>Sample data included</li>
            <li>JWT auth on every endpoint</li>
          </ul>
        </div>

        <div>
          <h3 class="text-lg font-semibold mb-2 text-teal">Image Service</h3>
          <ul class="list-disc list-inside text-gray-700 space-y-1 leading-relaxed">
            <li>R2 storage integration</li>
            <li>Photo galleries</li>
            <li>CDN-optimized delivery</li>
            <li>Admin upload (Auth0 ready)</li>
          </ul>
        </div>

        <div>
          <h3 class="text-lg font-semibold mb-2 text-teal">Forms Service</h3>
          <ul class="list-disc list-inside text-gray-700 space-y-1 leading-relaxed">
            <li>Contact form submissions</li>
            <li>D1 storage with metadata</li>
            <li>Rate limiting ready</li>
            <li>Admin view (Auth0 ready)</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 bg-navy rounded-lg p-8 text-white">
      <h2 class="text-2xl font-bold mb-4">Getting Started</h2>
      <div class="prose prose-invert max-w-none">
        <ol class="text-neutral-light space-y-2 text-base leading-relaxed">
          <li>Clone this repository</li>
          <li>Run <code class="bg-navy-light px-2 py-1 rounded text-sm font-mono text-teal">pnpm install</code></li>
          <li>Run <code class="bg-navy-light px-2 py-1 rounded text-sm font-mono text-teal">pnpm run setup</code> to initialize databases</li>
          <li>Run <code class="bg-navy-light px-2 py-1 rounded text-sm font-mono text-teal">pnpm dev</code> to start all services</li>
          <li>Visit <a href="/events" class="text-teal hover:text-teal-light font-semibold transition-colors">Events</a>, <a href="/news" class="text-teal hover:text-teal-light font-semibold transition-colors">News</a>, and <a href="/contact" class="text-teal hover:text-teal-light font-semibold transition-colors">Contact</a> to see it in action</li>
        </ol>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  code {
    font-family: 'Courier New', monospace;
  }
</style>
