---
import BaseLayout from '../layouts/BaseLayout.astro'
import type { RosterMember } from '../types'

const apiBaseUrl = `${Astro.url.protocol}//${Astro.url.host}`
let members: RosterMember[] = []
let error: string | null = null

try {
  const response = await fetch(`${apiBaseUrl}/api/content/roster`)
  if (response.ok) {
    const data = await response.json()
    members = data.members || []
  } else {
    error = 'Failed to load roster'
  }
} catch (e) {
  error = 'Could not connect to API. Make sure the gateway is running.'
}
---

<BaseLayout title="Roster" description="Meet our team members">
  <div class="bg-surface-brand text-on-brand py-12 border-b-4 border-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold">Our Team</h1>
      <p class="mt-2 text-on-brand-muted">Meet our talented performers and athletes</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    {error ? (
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-red-700">
        {error}
      </div>
    ) : members.length === 0 ? (
      <div class="bg-surface-elevated rounded-lg p-8 text-center text-on-surface-muted">
        No roster members found.
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {members.map((member) => (
          <div class="bg-surface-elevated rounded-lg shadow-sm overflow-hidden hover:shadow-md transition-shadow">
            {member.photo_url ? (
              <div class="aspect-square bg-surface">
                <img
                  src={member.photo_url}
                  alt={member.name}
                  class="w-full h-full object-cover"
                />
              </div>
            ) : (
              <div class="aspect-square bg-gradient-to-br from-surface-brand-light to-surface-brand flex items-center justify-center">
                <span class="text-6xl font-bold text-on-brand">
                  {member.name.charAt(0)}
                </span>
              </div>
            )}
            <div class="p-6">
              <h3 class="text-xl font-bold text-on-surface mb-1">{member.name}</h3>
              <div class="flex items-center gap-2 text-sm text-on-surface-muted mb-3">
                {member.role && (
                  <span class="px-2 py-1 bg-primary/10 text-primary rounded-full font-semibold">
                    {member.role}
                  </span>
                )}
                {member.grade && (
                  <span class="text-on-surface-faint">Grade {member.grade}</span>
                )}
              </div>
              {member.bio && (
                <p class="text-on-surface-muted text-sm">{member.bio}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
